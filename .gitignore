# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
venv/
.venv/

# Ignore the actual data files
data/raw/*.csv
data/processed/*.csv

# But allow DVC pointer files and gitkeep
!data/raw/*.dvc
!data/processed/*.dvc
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models — tracked via DVC
models/*.pkl
!models/*.dvc
!models/.gitkeep

# MLflow
mlruns/

# IDE
.vscode/
.idea/

# Docker
*.log